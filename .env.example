# Relay development configuration. Copy to .env; never commit secrets.
# Set DJANGO_SECRET_KEY to a random value of at least 50 characters.
# Set PGPASSWORD to the existing PostgreSQL relay account password.
# Production: RELAY_LOCAL_DEV=0, secure cookies/redirect=1, trusted hosts and HTTPS origins.
# Remote Ollama URLs send imported chat content to that server. No redirects/proxies are used.
# Models must support Ollama chat/embed APIs; structured JSON is required for chat models.
# Embedding dimensions must match the selected embedding model.
# Restart backend AND worker after editing. Model/chunk changes invalidate their cached outputs.

RELAY_LOCAL_DEV=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
PGHOST=127.0.0.1
PGPORT=55432
PGDATABASE=relay
PGUSER=relay
PGPASSWORD=
PGSSLMODE=disable
PGSSLROOTCERT=
HSTS_SECONDS=0
HSTS_SUBDOMAINS=0
TRUST_PROXY=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_ANSWER_MODEL=qwen3:1.7b
AI_TOPIC_MODEL=qwen3:1.7b
AI_TASK_MODEL=qwen3:1.7b
AI_TRANSLATION_MODEL=qwen3:1.7b
AI_EMBEDDING_MODEL=embeddinggemma:300m-qat-q4_0
AI_KEEP_ALIVE=5m
AI_REQUEST_TIMEOUT_SECONDS=120
AI_CONTEXT_TOKENS=8192
AI_ANSWER_MAX_TOKENS=1000
AI_TOPIC_MAX_TOKENS=1200
AI_TASK_MAX_TOKENS=1200
AI_TRANSLATION_MAX_TOKENS=1200
AI_TOPIC_BATCH_SIZE=6
AI_TASK_BATCH_SIZE=4
SEARCH_EMBEDDING_DIMENSIONS=768
SEARCH_CHUNK_SIZE=800
SEARCH_CHUNK_MAX_BYTES=1200
SEARCH_CHUNK_OVERLAP=120
SEARCH_RETRIEVAL_COUNT=8
SEARCH_MAX_SCAN_CHUNKS=25000
SEARCH_INDEX_BATCH_SIZE=12
WORKER_BUSY_POLL_SECONDS=1
WORKER_IDLE_POLL_SECONDS=3
WORKER_HEARTBEAT_SECONDS=15
WORKER_STALE_SECONDS=60
WORKER_LEASE_SECONDS=600
PGCONNECT_TIMEOUT=10
PGCONN_MAX_AGE=0
PGSTATEMENT_TIMEOUT_MS=15000
PGLOCK_TIMEOUT_MS=5000
SESSION_COOKIE_AGE=43200
IMPORT_MAX_BYTES=2097152
IMPORT_MAX_MESSAGES=10000
IMPORT_MAX_MESSAGE_LENGTH=20000
IMPORT_MAX_PENDING=5
USER_MAX_MESSAGES=100000
IMPORT_TTL_HOURS=24
AI_TEMPERATURE=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_SSL_REDIRECT=0
